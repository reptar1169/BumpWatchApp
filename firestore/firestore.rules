rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rides are written only by the submitRide Cloud Function, using the
    // Admin SDK, which bypasses these rules entirely. So `allow write` here
    // is intentionally false for every client (watch, web, anything else) --
    // the only way data gets in is through the function, which checks the
    // X-Api-Key header before it ever touches Firestore.
    match /rides/{rideId} {
      allow read: if true; // heatmap page reads ride metadata
      allow write: if false;
    }

    // NOT nested under /rides/{rideId} above -- a nested `match` only
    // covers reads scoped to one already-known parent ride (e.g.
    // collection(db, "rides", someId, "bumps")). The heatmap page instead
    // runs collectionGroup(db, "bumps") to read every ride's bumps at once,
    // and Firestore only honors collection-group reads through this
    // separate, explicitly recursive `{path=**}` pattern. Without this rule
    // on its own, the collectionGroup query is denied even though the
    // nested rule above "looks like" it should cover it.
    match /{path=**}/bumps/{bumpId} {
      allow read: if true; // heatmap page reads bumps (across all rides) to render the layer
      allow write: if false;
    }
  }
}

// If your heatmap page should NOT be public, replace `allow read: if true`
// above with something like:
//   allow read: if request.auth != null;
// and add Firebase Auth (even simple anonymous sign-in) to the web page.
