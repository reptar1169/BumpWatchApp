rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Rides are written only by the submitRide Cloud Function, using the
    // Admin SDK, which bypasses these rules entirely. So `allow write` here
    // is intentionally false for every client (watch, web, anything else) --
    // the only way data gets in is through the function, which verifies a
    // per-rider Firebase auth token (or, during the transition off the old
    // single shared key, the legacy X-Api-Key header -- see
    // authenticateRequest() in functions/index.js) before anything touches
    // Firestore.
    match /rides/{rideId} {
      allow read: if true; // heatmap page reads ride metadata
      allow write: if false;
    }

    // NOT nested under /rides/{rideId} above -- a nested `match` only
    // covers reads scoped to one already-known parent ride (e.g.
    // collection(db, "rides", someId, "bumps")). The heatmap page instead
    // runs collectionGroup(db, "bumps") to read every ride's bumps at once,
    // and Firestore only honors collection-group reads through this
    // separate, explicitly recursive `{path=**}` pattern. Without this rule
    // on its own, the collectionGroup query is denied even though the
    // nested rule above "looks like" it should cover it.
    match /{path=**}/bumps/{bumpId} {
      allow read: if true; // heatmap page reads bumps (across all rides) to render the layer
      allow write: if false;
    }

    // Written only by the recomputeTopStretches scheduled Cloud Function
    // (see functions/index.js), via the Admin SDK, which bypasses these
    // rules the same way submitRide does for `rides`/`bumps` above --
    // `allow write: if false` here is belt-and-suspenders, not the actual
    // gate. web/bikelanebumps-site/app.js reads this doc directly instead
    // of the old static top-stretches.json file.
    match /topStretches/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // pond2 / cardinal: unrelated to BumpWatch -- these back a separate
    // weather site whose sensors are Pi Picos writing straight to
    // Firestore's REST API. No auth requirement here (Firebase Auth's
    // token-refresh dance is more state than it's worth on a remote
    // microcontroller you can't easily walk over to), so reads AND writes
    // are still open to anyone who finds the project config -- the only
    // guardrail is a size cap, so an open collection can't turn into an
    // unbounded storage/cost sink from arbitrarily large documents.
    match /pond2/{docId} {
      allow read: if true;
      allow write: if request.resource.size() < 1024;
    }

    match /cardinal/{docId} {
      allow read: if true;
      allow write: if request.resource.size() < 1024;
    }
  }
}

// If your heatmap page should NOT be public, replace `allow read: if true`
// above with something like:
//   allow read: if request.auth != null;
// and add Firebase Auth (even simple anonymous sign-in) to the web page.
